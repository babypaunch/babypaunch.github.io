---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
{% for item in site.pages %}{% if item.sitemap != false and item.url != '/404.html' %}{% unless item.url contains '.css' %}
  <url>
    <loc>{{ item.url | replace: 'index.html', '' | absolute_url | xml_escape }}</loc>
  </url>
{% endunless %}{% endif %}{% endfor %}
{% for post in site.posts %}
  <url>
    <loc>{{ post.url | absolute_url | xml_escape }}</loc>
    <lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
{% if post.image %}{% if post.image contains '://' %}{% assign post_image_url = post.image %}{% else %}{% assign post_image_url = post.image | absolute_url %}{% endif %}
    <image:image>
      <image:loc>{{ post_image_url | xml_escape }}</image:loc>
      <image:title>{{ post.title | xml_escape }}</image:title>
    </image:image>
{% endif %}
  </url>
{% endfor %}
</urlset>
